{
  "_meta": {
    "note": "Fictional aircraft with recognizable class stats, to sidestep trademarks. Figures are designed game-balance values modeled loosely on real classes (noted in `basis`), not manufacturer data. This whole file is balance surface — tune freely.",
    "fields": {
      "seats": "single-class-ish seat count",
      "rangeKm": "max sector the type may be assigned to",
      "cruiseKmh": "block-speed input for frequency derivation",
      "turnaroundMin": "ground time between legs; longer for widebodies",
      "price": "purchase price, USD — approximate market transaction value, not list. Airlines never pay list.",
      "leaseMonthly": "lease rate, USD/month, charged 3x per quarter. Sits at roughly 0.7-0.8% of market value, which is the real relationship — keep it there if you retune price.",
      "fuelBurnLPerKm": "liters per km for the whole aircraft",
      "maintPerBlockHour": "maintenance $/block-hour at age 0, at approximately real rates",
      "maintAgeSlope": "added maintenance $/block-hour per year of age",
      "crewPerBlockHour": "loaded flight-deck and cabin crew cost per block hour",
      "introYear": "Year the type entered service. Historical types carry their real launch year; fictional future ones a target a game rolls around.",
      "introVariabilityYears": "How far the actual launch may slip early or late from introYear, in years. 0 = fixed historical date; above 0, each game rolls the arrival from the seed and a bad roll can push it past the horizon so it never comes."
    }
  },
