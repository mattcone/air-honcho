{
  // Static deploy to Cloudflare Workers. There is no backend and there never
  // will be — this config only serves the contents of ./dist.
  //
  //   npm run build && npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  // NOTE: this is the Worker name, so it is also the deployed hostname. Changing
  // it publishes to a NEW URL and leaves the old Worker running at the old one.
  "name": "air-honcho",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
